* text=auto eol=lf

*.csv text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.qmd text eol=lf
*.R text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Quarto-generated third-party bundles are preserved byte-for-byte.
assets/izvjestaji/**/libs/** -whitespace
docs/assets/izvjestaji/**/libs/** -whitespace

# Quarto owns these generated trees; source files retain normal whitespace checks.
_freeze/** -whitespace
docs/** -whitespace

*.db binary
*.gif binary
*.jpeg binary
*.jpg binary
*.parquet binary
*.pdf binary
*.png binary
*.rds binary
*.RData binary
*.udpipe binary
*.woff binary
*.woff2 binary
*.xlsx binary
