# R/RStudio
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto
/.quarto/

# Python (the .claude/hooks/ guards compile bytecode caches)
__pycache__/
*.pyc

# Build artifacts
*.log
*.tex
*.knit.*
*.utf8.md

# OS files
.DS_Store
Thumbs.db

# Conflicted copies (sync issues)
*conflicted copy*

# Large model files (optional - uncomment if needed)
# resources/models/*.udpipe

# Temporary files
*~
*.tmp
*.bak

# Large data files (too big for GitHub)
data/*.rds
data/merged_comprehensive.rds
data/merged_comprehensive_backup_*.rds
data/nlp/*.rds
data/raw/*.xlsx
data/raw/new/*.xlsx
# Stray drop-folder some scrapes land in (NOT the documented data/raw/new/) — holds raw
# mentions(*).xlsx + a copy of the 1 GB master .rds; never commit. Ignore the whole folder.
data/new/
# Semantic-search (Level 3) store: local DuckDB vector store + its prepared input. Large, and it
# holds raw post text + embeddings (NOT shareable). Machine-local only; rebuilt by R/semantic/*.
# Also Dropbox-ignored (com.dropbox.ignored attr) — a synced .duckdb would file-lock (CLAUDE.local.md).
data/semantic/
data/private/
# NOTE: data/processed/*.rds, data/page-ready/*.rds, and data/sample/*.rds ARE intentionally
# tracked (CC BY 4.0, no row-level text/URLs/PII).
# Do NOT broaden the pattern to data/**/*.rds — that would silently drop those shareable aggregates.

**/*.quarto_ipynb

# Claude Code workflow — local overrides (never commit machine paths / personal settings)
# NOTE: the rest of .claude/ (settings.json, rules/, hooks/, skills/, agents/) IS committed & shared.
CLAUDE.local.md
.claude/settings.local.json

# Claude Code — session logs are local; plans (quality_reports/plans/) ARE tracked
quality_reports/session_logs/
quality_reports/recovery/

# Exploration sandbox outputs are throwaway (the explorations themselves ARE tracked)
explorations/*/output/

# Study working slices carry RAW post text (PII) and are large (~450 MB each) — NEVER commit.
# Small aggregate tables/figures under studies/*/output/ stay trackable (no PII, CC BY 4.0);
# run /disclosure-check before committing any of them.
studies/*/output/*.rds
studies/*/output/**/*.rds
studies/*/output/private/
studies/*/output/intermediate/

# Semantic exploration products are generated, local, and may contain sampled
# post text or embeddings. Keep scripts/README tracked; keep their outputs out.
/R/semantic/*.rds
/R/semantic/*.png
/R/semantic/*.csv
/R/semantic/_cluster_samples_for_reading.md

# Local previews and source-adjacent manuscript renders are not publication
# targets. The canonical website render lives only in docs/.
/preview/
/studies/**/*.html
/studies/**/*_files/
/quality_reports/**/*.html
/quality_reports/**/*_files/
/README.html
/README_files/

# ── Render output that must only ever live under docs/ (output-dir: docs) ──
# A Quarto render run the wrong way (a single page from inside a source dir, or with the project
# undetected) scatters HTML, site_libs/ and *_files/ beside the sources, and can even EMPTY docs/.
# These patterns make that stray output un-stageable so it can never be committed or clutter
# `git status`. They are scoped to the active source dirs (pages/ and the repo root)
# and deliberately spare the real site output under docs/.
#
# pages/ — the main website sources
/pages/**/*.html
/pages/**/site_libs/
/pages/**/*_files/
# R/ — guard against accidental ad-hoc analysis renders
/R/*.html
/R/site_libs/
/R/**/*_files/
# repo root — a project-level mis-render drops these at the top level (NOT README.html/README_files/)
/site_libs/
/index.html
/search.json
/sitemap.xml
/robots.txt
# transient Quarto intermediate — safe to ignore anywhere (never tracked, incl. under docs/)
*.rmarkdown
